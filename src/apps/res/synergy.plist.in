<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<!-- macOS resolves the app locale only from the localizations a bundle
	     declares; without this list a Chinese system falls back to the
	     development region and QLocale() reports English. Keep in step with
	     the .ts files under translations/ (zh_CN is matched through
	     zh-Hans/zh-Hant). -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>it</string>
		<string>ja</string>
		<string>ko</string>
		<string>ru</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>@BUNDLE_EXECUTABLE_NAME@</string>
	<key>CFBundleGetInfoString</key>
	<string>@BUNDLE_INFO_STRING@</string>
	<key>CFBundleIconFile</key>
	<string>@BUNDLE_ICON_FILE@</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_GUI_IDENTIFIER@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleName</key>
	<string>@BUNDLE_BUNDLE_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>@CMAKE_PROJECT_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@BUNDLE_COPYRIGHT@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>

	<!-- Prevent macOS from terminating during memory pressure -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Local Lan Entitlements -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app uses local network permissions for communication between a @CMAKE_PROJECT_PROPER_NAME@ server and clients.</string>
	<key>com.apple.security.networking.local</key>
	<true/>

	<!-- Accessibility Entitlements -->
	<key>com.apple.security.accessibility</key>
	<array>
		<dict>
			<key>com.apple.security.accessibility.read</key>
			<true/>
			<key>com.apple.security.accessibility.write</key>
			<true/>
			<key>com.apple.security.accessibility.execute</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
