# Inspect providers before linking: a static archive with newer object minima
# can otherwise be linked into an executable whose metadata still claims an
# older deployment target. Inspect every recorded member minimum per slice.
function(synergy_check_macos_provider library)
  if(NOT IS_ABSOLUTE "${library}" OR NOT EXISTS "${library}")
    message(FATAL_ERROR "Missing macOS dependency provider: ${library}")
  endif()
  set(architectures "${CMAKE_OSX_ARCHITECTURES}")
  if(NOT architectures)
    set(architectures "${CMAKE_SYSTEM_PROCESSOR}")
  endif()
  foreach(architecture IN LISTS architectures)
    execute_process(COMMAND /usr/bin/otool -arch "${architecture}" -l "${library}"
      RESULT_VARIABLE result OUTPUT_VARIABLE commands ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot inspect macOS provider ${library} (${architecture}): ${error}")
    endif()
    string(REPLACE "\n" ";" lines "${commands}")
    set(command "")
    set(found FALSE)
    set(member "")
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line MATCHES "^.+:$")
        if(member AND NOT found)
          message(FATAL_ERROR "No macOS deployment metadata in provider member ${member} (${architecture})")
        endif()
        set(member "${line}")
        set(found FALSE)
        set(command "")
      elseif(line MATCHES "^cmd (LC_[A-Z0-9_]+)$")
        set(command "${CMAKE_MATCH_1}")
      elseif(line MATCHES "^(minos|version) ([0-9]+(\\.[0-9]+)*)$")
        set(field "${CMAKE_MATCH_1}")
        set(minimum "${CMAKE_MATCH_2}")
        if(NOT ((command STREQUAL "LC_BUILD_VERSION" AND field STREQUAL "minos") OR
                (command STREQUAL "LC_VERSION_MIN_MACOSX" AND field STREQUAL "version")))
          continue()
        endif()
        set(found TRUE)
        if(CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS minimum)
          message(FATAL_ERROR "macOS provider ${library} (${architecture}) requires ${minimum}, above requested deployment target ${CMAKE_OSX_DEPLOYMENT_TARGET}")
        endif()
      endif()
    endforeach()
    if(NOT member OR NOT found)
      message(FATAL_ERROR "No macOS deployment metadata in provider member ${library} ${member} (${architecture})")
    endif()
  endforeach()
endfunction()

function(synergy_check_macos_target target)
  if(NOT TARGET "${target}")
    if(ARGV1 STREQUAL "REQUIRED")
      message(FATAL_ERROR "Missing required macOS dependency target: ${target}")
    endif()
    return()
  endif()
  get_target_property(aliased_target "${target}" ALIASED_TARGET)
  if(aliased_target)
    set(target "${aliased_target}")
  endif()
  get_target_property(type "${target}" TYPE)
  if(type STREQUAL "INTERFACE_LIBRARY")
    if(ARGV1 STREQUAL "REQUIRED")
      message(FATAL_ERROR "No inspectable macOS runtime provider for ${target}")
    endif()
    return()
  endif()
  foreach(property IN ITEMS IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_LOCATION)
    get_target_property(location "${target}" ${property})
    if(location)
      synergy_check_macos_provider("${location}")
      if(ARGC GREATER 2)
        set("${ARGV2}" "${location}" PARENT_SCOPE)
      endif()
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "No inspectable macOS runtime provider for ${target}")
endfunction()
