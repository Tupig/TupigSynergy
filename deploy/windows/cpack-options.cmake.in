if(CPACK_GENERATOR MATCHES 7Z|ZIP)
  set(CPACK_PACKAGE_FILE_NAME ${CPACK_PACKAGE_FILE_NAME}-portable)
endif()
if(CPACK_GENERATOR MATCHES "(^|;)7Z(;|$)")
  if(CMAKE_VERSION VERSION_LESS "4.3")
    message(FATAL_ERROR "7Z maximum compression requires CPack 4.3 or newer")
  endif()
  set(CPACK_ARCHIVE_COMPRESSION_LEVEL 9)
  message(STATUS "Windows 7Z archive compression level: ${CPACK_ARCHIVE_COMPRESSION_LEVEL}")
endif()
