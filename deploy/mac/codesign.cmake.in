# Sign the complete staged payload after dependency fixups and resource copying.
set(app "${CPACK_TEMPORARY_INSTALL_DIRECTORY}/@CMAKE_PROJECT_PROPER_NAME@.app")
set(identity "@APPLE_CODESIGN_ID@")
if(NOT identity)
  set(identity "-")
endif()
set(mode "$ENV{MACOS_SIGNING_MODE}")
if(NOT mode OR identity STREQUAL "-")
  set(mode developer-id)
endif()
set(keychain_args "")
if(NOT "$ENV{SIGN_KEYCHAIN}" STREQUAL "")
  list(APPEND keychain_args --keychain "$ENV{SIGN_KEYCHAIN}")
endif()
find_program(signing_python NAMES python3 REQUIRED)
execute_process(
  COMMAND "${signing_python}" "@CMAKE_SOURCE_DIR@/scripts/ci/sign-macos-app.py"
    "${app}" --identity "${identity}" --mode "${mode}" ${keychain_args}
    --installer-template "@CMAKE_SOURCE_DIR@/deploy/mac/install.command.in"
  RESULT_VARIABLE signing_result
)
if(NOT signing_result EQUAL 0)
  message(FATAL_ERROR "Mac application signing or identity verification failed (${signing_result})")
endif()
