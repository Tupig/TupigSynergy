# MSI-specific, read-only WiX 5.0.2 metadata and payload reconciliation.
set(MSI64_AUDIT_API_VERSION 1)

function(_msi64_bad kind detail)
  message(STATUS "MSI_AUDIT_MAPPING_REJECT kind=${kind} detail=${detail}")
  message(FATAL_ERROR "MSI mapping is incomplete or ambiguous")
endfunction()
function(_msi64_decode value out)
  foreach(pair IN ITEMS "lt|<" "gt|>" "quot|\"" "apos|'")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 entity)
    list(GET parts 1 literal)
    string(REPLACE "&${entity};" "${literal}" value "${value}")
  endforeach()
  string(REPLACE "&amp;" "&" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_msi64_attr tag name out)
  if(NOT tag MATCHES "[ \t\r\n]${name}=\"([^\"]*)\"")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  _msi64_decode("${CMAKE_MATCH_1}" value)
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_msi64_field table row col out)
  get_property(columns GLOBAL PROPERTY "_msi64_${table}_${row}_columns")
  if(columns STREQUAL "" OR col GREATER columns)
    set(value "")
  else()
    get_property(value GLOBAL PROPERTY "_msi64_${table}_${row}_${col}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_msi64_id value)
  if(NOT value MATCHES "^[A-Za-z_][A-Za-z0-9_.-]*$")
    _msi64_bad(unknown-object "unsafe identifier")
  endif()
endfunction()
function(_msi64_rows table body)
  set(count 0)
  set(ids "")
  while(body MATCHES "<row[^>]*>")
    set(head "${CMAKE_MATCH_0}")
    string(FIND "${body}" "${head}" at)
    string(LENGTH "${head}" length)
    math(EXPR at "${at}+${length}")
    string(SUBSTRING "${body}" ${at} -1 body)
    string(FIND "${body}" "</row>" end)
    if(end LESS 0)
      _msi64_bad(unknown-object "unterminated ${table} row")
    endif()
    string(SUBSTRING "${body}" 0 ${end} row)
    math(EXPR end "${end}+6")
    string(SUBSTRING "${body}" ${end} -1 body)
    math(EXPR count "${count}+1")
    set(col 0)
    while(row MATCHES "^<field[^>]*>")
      set(head "${CMAKE_MATCH_0}")
      string(LENGTH "${head}" length)
      string(SUBSTRING "${row}" ${length} -1 row)
      if(head MATCHES "/>$")
        set(value "")
      else()
        string(FIND "${row}" "</field>" end)
        if(end LESS 0)
          _msi64_bad(unknown-object "unterminated ${table} field")
        endif()
        string(SUBSTRING "${row}" 0 ${end} value)
        math(EXPR end "${end}+8")
        string(SUBSTRING "${row}" ${end} -1 row)
      endif()
      if(value MATCHES "<")
        _msi64_bad(unknown-object "nested ${table} field")
      endif()
      _msi64_decode("${value}" value)
      math(EXPR col "${col}+1")
      set_property(GLOBAL PROPERTY "_msi64_${table}_${count}_${col}" "${value}")
    endwhile()
    if(NOT row STREQUAL "")
      _msi64_bad(unknown-object "unparsed ${table} row")
    endif()
    set_property(GLOBAL PROPERTY "_msi64_${table}_${count}_columns" "${col}")
    _msi64_field("${table}" "${count}" 1 id)
    if(id IN_LIST ids)
      if(table STREQUAL "Binary")
        _msi64_bad(duplicate-binary "${id}")
      else()
        _msi64_bad(unknown-object "duplicate ${table} ${id}")
      endif()
    endif()
    list(APPEND ids "${id}")
  endwhile()
  string(STRIP "${body}" body)
  if(NOT body STREQUAL "")
    _msi64_bad(unknown-object "unparsed ${table} content")
  endif()
  set_property(GLOBAL PROPERTY "_msi64_${table}_count" "${count}")
  set_property(GLOBAL PROPERTY "_msi64_${table}_ids" "${ids}")
endfunction()
function(_msi64_path root raw expected out)
  string(REPLACE "\\" "/" raw "${raw}")
  if(raw MATCHES "[;\r\n]" OR raw MATCHES "(^|/)\\.\\.(/|$)")
    _msi64_bad(unknown-object "unsafe export path")
  endif()
  if(NOT IS_ABSOLUTE "${raw}")
    get_filename_component(base "${root}" DIRECTORY)
    set(raw "${base}/${raw}")
  endif()
  get_filename_component(raw "${raw}" ABSOLUTE)
  set(wanted "${root}/${expected}")
  if(NOT raw STREQUAL wanted)
    _msi64_bad(unknown-object "unexpected export ${expected} raw=${raw} wanted=${wanted}")
  endif()
  if(NOT EXISTS "${wanted}" OR IS_DIRECTORY "${wanted}")
    _msi64_bad(missing-export "${expected}")
  endif()
  file(REAL_PATH "${wanted}" real)
  if(IS_SYMLINK "${wanted}" OR NOT real STREQUAL wanted)
    _msi64_bad(unknown-object "symlink export ${expected}")
  endif()
  set(${out} "${wanted}" PARENT_SCOPE)
endfunction()
function(_msi64_reconcile source_xml data_xml source_root data_root expected_arch)
  foreach(document IN ITEMS "${source_xml}" "${data_xml}")
    file(REAL_PATH "${document}" real)
    if(NOT EXISTS "${document}" OR IS_DIRECTORY "${document}" OR IS_SYMLINK "${document}" OR NOT real STREQUAL document)
      _msi64_bad(unknown-object "unsafe metadata document")
    endif()
  endforeach()
  foreach(table IN ITEMS File Binary Icon CustomAction _SummaryInformation Component Directory)
    set_property(GLOBAL PROPERTY "_msi64_${table}_count" 0)
    set_property(GLOBAL PROPERTY "_msi64_${table}_ids" "")
    set_property(GLOBAL PROPERTY "_msi64_${table}_object_column" "")
  endforeach()
  foreach(root IN ITEMS "${source_root}" "${data_root}")
    file(REAL_PATH "${root}" real)
    if(NOT IS_DIRECTORY "${root}" OR IS_SYMLINK "${root}" OR NOT real STREQUAL root)
      _msi64_bad(unknown-object "unsafe export root")
    endif()
  endforeach()
  file(READ "${data_xml}" xml)
  file(READ "${source_xml}" source)
  set(source_actions "${source}")
  if(xml MATCHES "<!" OR source MATCHES "<!DOCTYPE|<!ENTITY" OR NOT xml MATCHES "<windowsInstallerData [^>]*xmlns=\"http://wixtoolset.org/schemas/v4/windowsinstallerdata\"")
    _msi64_bad(unknown-object "unsupported data XML")
  endif()
  string(REGEX MATCH "<tableDefinitions[^>]*>.*</tableDefinitions>" defs "${xml}")
  if(defs STREQUAL "")
    _msi64_bad(unknown-object "missing table definitions")
  endif()
  string(REPLACE "${defs}" "" remaining "${xml}")
  set(object_tables "")
  while(defs MATCHES "<tableDefinition name=\"([^\"]+)\">")
    set(table "${CMAKE_MATCH_1}")
    _msi64_id("${table}")
    set(head "${CMAKE_MATCH_0}")
    string(FIND "${defs}" "${head}" at)
    string(LENGTH "${head}" length)
    math(EXPR at "${at}+${length}")
    string(SUBSTRING "${defs}" ${at} -1 defs)
    string(FIND "${defs}" "</tableDefinition>" end)
    if(end LESS 0)
      _msi64_bad(unknown-object "unterminated definition")
    endif()
    string(SUBSTRING "${defs}" 0 ${end} columns)
    math(EXPR end "${end}+18")
    string(SUBSTRING "${defs}" ${end} -1 defs)
    set(index 0)
    while(columns MATCHES "<columnDefinition [^>]*/>")
      set(column "${CMAKE_MATCH_0}")
      string(FIND "${columns}" "${column}" at)
      string(LENGTH "${column}" length)
      math(EXPR at "${at}+${length}")
      string(SUBSTRING "${columns}" ${at} -1 columns)
      math(EXPR index "${index}+1")
      _msi64_attr("${column}" type type)
      if(type STREQUAL "object")
        if(table IN_LIST object_tables)
          _msi64_bad(unknown-object "multiple Object columns ${table}")
        endif()
        list(APPEND object_tables "${table}")
        set_property(GLOBAL PROPERTY "_msi64_${table}_object_column" "${index}")
      endif()
    endwhile()
  endwhile()
  set(tables "")
  while(remaining MATCHES "<table name=\"([^\"]+)\">")
    set(table "${CMAKE_MATCH_1}")
    set(head "${CMAKE_MATCH_0}")
    _msi64_id("${table}")
    if(table IN_LIST tables)
      _msi64_bad(unknown-object "duplicate table ${table}")
    endif()
    list(APPEND tables "${table}")
    string(FIND "${remaining}" "${head}" at)
    string(LENGTH "${head}" length)
    math(EXPR at "${at}+${length}")
    string(SUBSTRING "${remaining}" ${at} -1 remaining)
    string(FIND "${remaining}" "</table>" end)
    if(end LESS 0)
      _msi64_bad(unknown-object "unterminated table ${table}")
    endif()
    string(SUBSTRING "${remaining}" 0 ${end} body)
    math(EXPR end "${end}+8")
    string(SUBSTRING "${remaining}" ${end} -1 remaining)
    if(table IN_LIST object_tables OR table MATCHES "^(CustomAction|_SummaryInformation|Component|Directory)$")
      _msi64_rows("${table}" "${body}")
    endif()
  endwhile()
  foreach(table IN LISTS object_tables)
    if(table IN_LIST tables AND NOT table MATCHES "^(File|Binary|Icon)$")
      _msi64_bad(unknown-object "unsupported Object table ${table}")
    endif()
  endforeach()
  set(objects "")
  set(files "")
  foreach(table IN ITEMS File Binary Icon)
    if(NOT table IN_LIST tables)
      set_property(GLOBAL PROPERTY "_msi64_${table}_count" 0)
      set_property(GLOBAL PROPERTY "_msi64_${table}_ids" "")
      continue()
    endif()
    get_property(column GLOBAL PROPERTY "_msi64_${table}_object_column")
    if((table STREQUAL "File" AND NOT column STREQUAL "10") OR
        (NOT table STREQUAL "File" AND NOT column STREQUAL "2"))
      _msi64_bad(unknown-object "unsupported Object column ${table}")
    endif()
    get_property(count GLOBAL PROPERTY "_msi64_${table}_count")
    if(count GREATER 0)
      foreach(row RANGE 1 ${count})
        _msi64_field("${table}" "${row}" 1 id)
        _msi64_id("${id}")
        _msi64_field("${table}" "${row}" "${column}" raw)
        _msi64_path("${data_root}" "${raw}" "${table}/${id}" path)
        list(APPEND objects "${table}/${id}")
        set_property(GLOBAL PROPERTY "_msi64_object_${table}_${id}" "${path}")
        set_property(GLOBAL PROPERTY "_msi64_actions_${table}_${id}" "")
        if(table STREQUAL "File")
          list(APPEND files "${id}")
          set_property(GLOBAL PROPERTY "_msi64_file_row_${id}" "${row}")
        endif()
      endforeach()
    endif()
  endforeach()
  set(source_objects "")
  while(source MATCHES "<(File|Binary|Icon) [^>]*>")
    set(table "${CMAKE_MATCH_1}")
    set(tag "${CMAKE_MATCH_0}")
    string(FIND "${source}" "${tag}" at)
    string(LENGTH "${tag}" length)
    math(EXPR at "${at}+${length}")
    string(SUBSTRING "${source}" ${at} -1 source)
    _msi64_attr("${tag}" Id id)
    _msi64_id("${id}")
    set(key "${table}/${id}")
    if(key IN_LIST source_objects)
      _msi64_bad(unknown-object "duplicate source ${key}")
    endif()
    if(NOT key IN_LIST objects)
      _msi64_bad(unknown-object "source ${key}")
    endif()
    list(APPEND source_objects "${key}")
    if(table STREQUAL "File")
      _msi64_attr("${tag}" Source raw)
    else()
      _msi64_attr("${tag}" SourceFile raw)
    endif()
    _msi64_path("${source_root}" "${raw}" "${key}" source_path)
    get_property(data_path GLOBAL PROPERTY "_msi64_object_${table}_${id}")
    file(SHA256 "${source_path}" source_sha)
    file(SHA256 "${data_path}" data_sha)
    if(NOT source_sha STREQUAL data_sha)
      _msi64_bad(unknown-object "source/data mismatch ${key}")
    endif()
    message(STATUS "MSI_AUDIT_OBJECT table=${table} stream=${id} export=${key} sha256=${data_sha}")
  endwhile()
  list(SORT objects)
  list(SORT source_objects)
  if(NOT objects STREQUAL source_objects)
    _msi64_bad(missing-export "source Object mapping")
  endif()
  foreach(root IN ITEMS "${source_root}" "${data_root}")
    file(GLOB_RECURSE entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*")
    set(exports "")
    foreach(entry IN LISTS entries)
      if(IS_SYMLINK "${root}/${entry}")
        _msi64_bad(unknown-object "symlink export")
      elseif(NOT IS_DIRECTORY "${root}/${entry}")
        list(APPEND exports "${entry}")
      endif()
    endforeach()
    list(SORT exports)
    if(NOT exports STREQUAL objects)
      _msi64_bad(unknown-object "unmapped export")
    endif()
  endforeach()
  set(source_action_ids "")
  while(source_actions MATCHES "<CustomAction [^>]*>")
    set(tag "${CMAKE_MATCH_0}")
    string(FIND "${source_actions}" "${tag}" at)
    string(LENGTH "${tag}" length)
    math(EXPR at "${at}+${length}")
    string(SUBSTRING "${source_actions}" ${at} -1 source_actions)
    _msi64_attr("${tag}" Id id)
    _msi64_id("${id}")
    if(id IN_LIST source_action_ids)
      _msi64_bad(unknown-object "duplicate source CustomAction ${id}")
    endif()
    list(APPEND source_action_ids "${id}")
    foreach(attr IN ITEMS BinaryRef FileRef Directory Property)
      _msi64_attr("${tag}" "${attr}" value)
      set_property(GLOBAL PROPERTY "_msi64_sourceca_${id}_${attr}" "${value}")
    endforeach()
  endwhile()
  set(actions 0)
  set(action_ids "")
  if("CustomAction" IN_LIST tables)
    get_property(actions GLOBAL PROPERTY _msi64_CustomAction_count)
    if(actions GREATER 0)
      foreach(row RANGE 1 ${actions})
        _msi64_field(CustomAction "${row}" 1 action)
        _msi64_id("${action}")
        list(APPEND action_ids "${action}")
        _msi64_field(CustomAction "${row}" 2 type)
        _msi64_field(CustomAction "${row}" 3 id)
        if(NOT type MATCHES "^[0-9]+$")
          _msi64_bad(unknown-object "CustomAction type ${action}")
        endif()
        math(EXPR base "${type} & 63")
        if(base MATCHES "^(1|2|5|6)$")
          set(table Binary)
        elseif(base MATCHES "^(17|18|21|22)$")
          set(table File)
        elseif(base MATCHES "^(34|35)$")
          set(table Directory)
        elseif(base MATCHES "^(50|51|53|54)$")
          set(table Property)
        elseif(base MATCHES "^(19|37|38)$")
          set(table Inline)
        else()
          _msi64_bad(unknown-object "unsupported CustomAction ${action}")
        endif()
        if(table MATCHES "^(Binary|File|Directory)$")
          get_property(ids GLOBAL PROPERTY "_msi64_${table}_ids")
          if(NOT id IN_LIST ids)
            _msi64_bad(missing-export "CustomAction ${action} source ${table}/${id}")
          endif()
        endif()
        if(table STREQUAL "Binary")
          set(attr BinaryRef)
        elseif(table STREQUAL "File")
          set(attr FileRef)
        else()
          set(attr "${table}")
        endif()
        if(NOT table STREQUAL "Inline")
          get_property(source_id GLOBAL PROPERTY "_msi64_sourceca_${action}_${attr}")
          if(NOT source_id STREQUAL id)
            _msi64_bad(unknown-object "CustomAction source/data mismatch ${action}")
          endif()
        endif()
        if(table MATCHES "^(Binary|File)$")
          get_property(previous GLOBAL PROPERTY "_msi64_actions_${table}_${id}")
          if(previous STREQUAL "")
            set(previous "${action}")
          else()
            string(APPEND previous ",${action}")
          endif()
          set_property(GLOBAL PROPERTY "_msi64_actions_${table}_${id}" "${previous}")
        endif()
        message(STATUS "MSI_AUDIT_ACTION action=${action} table=${table} stream=${id}")
      endforeach()
    endif()
  endif()
  list(SORT source_action_ids)
  list(SORT action_ids)
  if(NOT source_action_ids STREQUAL action_ids)
    _msi64_bad(unknown-object "missing or unknown source CustomAction")
  endif()
  get_property(summary_count GLOBAL PROPERTY _msi64__SummaryInformation_count)
  set(summary "")
  if(summary_count GREATER 0)
    foreach(row RANGE 1 ${summary_count})
      _msi64_field(_SummaryInformation "${row}" 1 id)
      if(id STREQUAL "7")
        _msi64_field(_SummaryInformation "${row}" 2 summary)
      endif()
    endforeach()
  endif()
  if(expected_arch STREQUAL "x64")
    set(template x64)
  elseif(expected_arch STREQUAL "arm64")
    set(template Arm64)
  else()
    _msi64_bad(unknown-object "unsupported expected architecture")
  endif()
  if(NOT summary MATCHES "^${template};[0-9,]+$")
    _msi64_bad(unknown-object "unexpected SummaryInformation template")
  endif()
  message(STATUS "MSI_AUDIT_SUMMARY template=${summary}")
  list(LENGTH files file_count)
  list(LENGTH objects object_count)
  message(STATUS "MSI_AUDIT_COUNTS files=${file_count} objects=${object_count} actions=${actions} exports_source=${object_count} exports_data=${object_count}")
  set_property(GLOBAL PROPERTY _msi64_objects "${objects}")
  set_property(GLOBAL PROPERTY _msi64_files "${files}")
endfunction()

function(_msi64_command)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
  if(NOT "${rc}" STREQUAL "0")
    message(FATAL_ERROR "Read-only MSI command failed (${rc}): ${stdout}\n${stderr}")
  endif()
  set(_msi64_stdout "${stdout}" PARENT_SCOPE)
endfunction()
function(_msi64_extract input output expected)
  if(NOT WIN32)
    message(FATAL_ERROR "Native MSI extraction requires Windows")
  endif()
  file(REAL_PATH "${input}" real_input)
  if(NOT IS_ABSOLUTE "${input}" OR NOT EXISTS "${input}" OR IS_SYMLINK "${input}" OR IS_DIRECTORY "${input}" OR
      NOT real_input STREQUAL input OR input MATCHES "[;\r\n]")
    message(FATAL_ERROR "MSI_INPUT must be an existing absolute regular file")
  endif()
  if(NOT IS_ABSOLUTE "${output}" OR EXISTS "${output}" OR IS_SYMLINK "${output}" OR
      output MATCHES "(^|[/\\])\\.\\.([/\\]|$)|[;\r\n]")
    message(FATAL_ERROR "MSI_AUDIT_DIR must be a fresh absolute path")
  endif()
  get_filename_component(parent "${output}" DIRECTORY)
  get_filename_component(input_parent "${input}" DIRECTORY)
  file(RELATIVE_PATH contained "${input_parent}" "${output}")
  if(contained MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${contained}" OR contained STREQUAL "")
    message(FATAL_ERROR "MSI_AUDIT_DIR must remain below the input directory")
  endif()
  file(REAL_PATH "${parent}" real_parent)
  if(NOT IS_DIRECTORY "${parent}" OR NOT real_parent STREQUAL parent)
    message(FATAL_ERROR "MSI_AUDIT_DIR parent must exist without symlinks")
  endif()
  file(SHA256 "${input}" before)
  message(STATUS "MSI_AUDIT_API version=1")
  message(STATUS "MSI_AUDIT_INPUT sha256=${before} expected=${expected}")
  find_program(MSI64_WIX NAMES wix REQUIRED)
  _msi64_command("${MSI64_WIX}" --version)
  if(NOT _msi64_stdout MATCHES "^5\\.0\\.2([+\r\n-]|$)")
    message(FATAL_ERROR "MSI audit requires exact WiX 5.0.2")
  endif()
  file(MAKE_DIRECTORY "${output}")
  _msi64_command("${MSI64_WIX}" msi decompile "${input}" -x "${output}/exports-source" -o "${output}/source.wxs")
  _msi64_command("${MSI64_WIX}" msi decompile "${input}" -data -x "${output}/exports-data" -o "${output}/tables.wixout")
  file(ARCHIVE_EXTRACT INPUT "${output}/tables.wixout" DESTINATION "${output}/table-container")
  file(SHA256 "${input}" after)
  message(STATUS "MSI_AUDIT_INPUT_AFTER sha256=${after}")
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Read-only MSI audit changed its input")
  endif()
  _msi64_reconcile("${output}/source.wxs" "${output}/table-container/wix-wid.xml" "${output}/exports-source" "${output}/exports-data" "${expected}")
endfunction()
function(_msi64_segment name)
  string(TOLOWER "${name}" lower)
  if(name STREQUAL "" OR name MATCHES "[/\\:;\r\n<>\"|?*]" OR name MATCHES "^\\.\\.?$|[. ]$" OR
      lower MATCHES "^(con|prn|aux|nul|com[1-9]|lpt[1-9])([.]|$)")
    _msi64_bad(unknown-object "unsafe payload path component")
  endif()
endfunction()
function(_msi64_directory id chain out)
  if(id IN_LIST chain)
    _msi64_bad(unknown-object "Directory cycle")
  endif()
  list(APPEND chain "${id}")
  get_property(ids GLOBAL PROPERTY _msi64_Directory_ids)
  list(FIND ids "${id}" index)
  if(index LESS 0)
    _msi64_bad(missing-export "Directory ${id}")
  endif()
  math(EXPR row "${index}+1")
  _msi64_field(Directory "${row}" 2 parent)
  _msi64_field(Directory "${row}" 3 name)
  if(parent STREQUAL "")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE ":.*$" "" name "${name}")
  string(REGEX REPLACE "^.*\\|" "" name "${name}")
  if(name STREQUAL ".")
    set(name "")
  endif()
  if(NOT name STREQUAL "")
    _msi64_segment("${name}")
  endif()
  _msi64_directory("${parent}" "${chain}" prefix)
  if(prefix STREQUAL "")
    set(path "${name}")
  elseif(name STREQUAL "")
    set(path "${prefix}")
  else()
    set(path "${prefix}/${name}")
  endif()
  set(${out} "${path}" PARENT_SCOPE)
endfunction()
function(_msi64_payload destination)
  if(EXISTS "${destination}")
    message(FATAL_ERROR "MSI payload staging must be fresh")
  endif()
  file(MAKE_DIRECTORY "${destination}")
  get_property(files GLOBAL PROPERTY _msi64_files)
  get_property(components GLOBAL PROPERTY _msi64_Component_ids)
  set(paths "")
  foreach(id IN LISTS files)
    get_property(row GLOBAL PROPERTY "_msi64_file_row_${id}")
    _msi64_field(File "${row}" 2 component)
    list(FIND components "${component}" index)
    if(index LESS 0)
      _msi64_bad(missing-export "File component ${id}")
    endif()
    math(EXPR component_row "${index}+1")
    _msi64_field(Component "${component_row}" 3 directory)
    _msi64_directory("${directory}" "" path)
    _msi64_field(File "${row}" 3 name)
    string(REGEX REPLACE "^.*\\|" "" name "${name}")
    _msi64_segment("${name}")
    set(relative "${path}/${name}")
    string(TOLOWER "${relative}" key)
    if(key IN_LIST paths)
      _msi64_bad(unknown-object "duplicate destination ${relative}")
    endif()
    list(APPEND paths "${key}")
    get_property(source GLOBAL PROPERTY "_msi64_object_File_${id}")
    file(MAKE_DIRECTORY "${destination}/${path}")
    configure_file("${source}" "${destination}/${relative}" COPYONLY)
  endforeach()
endfunction()
