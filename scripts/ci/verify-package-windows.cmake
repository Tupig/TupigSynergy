cmake_minimum_required(VERSION 3.21)

# The expected ABI is supplied by the build, never inferred from payload bytes.
string(TOLOWER "${EXPECTED_ARCH}" _target_arch)
if(_target_arch MATCHES "^(x64|x86_64|amd64)$")
  set(_target_arch x64)
elseif(_target_arch MATCHES "^(arm64|aarch64)$")
  set(_target_arch arm64)
else()
  message(FATAL_ERROR "Missing or unsupported expected target architecture: ${EXPECTED_ARCH}")
endif()

function(_v64_escape value out)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_v64_add name amount)
  get_property(value GLOBAL PROPERTY "_v64_${name}")
  if(NOT value)
    set(value 0)
  endif()
  math(EXPR value "${value}+${amount}")
  set_property(GLOBAL PROPERTY "_v64_${name}" "${value}")
endfunction()
function(_v64_fail relative observed member)
  string(REPLACE "_" "/" observed "${observed}")
  get_property(previous GLOBAL PROPERTY _v64_error)
  if(NOT previous)
    set(detail "file=${relative};observed=${observed};expected=${_target_arch}")
    if(NOT member STREQUAL "")
      string(APPEND detail ";member=${member}")
    endif()
    set_property(GLOBAL PROPERTY _v64_error "${detail}")
  endif()
endfunction()
function(_v64_ascii hex out)
  string(LENGTH "${hex}" length)
  set(value "")
  if(length GREATER 0)
    math(EXPR end "${length}-2")
    foreach(i RANGE 0 ${end} 2)
      string(SUBSTRING "${hex}" ${i} 2 byte)
      math(EXPR code "0x${byte}")
      if(code EQUAL 0)
        message(FATAL_ERROR "Malformed archive text field")
      endif()
      string(ASCII ${code} char)
      string(APPEND value "${char}")
    endforeach()
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(_v64_u32 hex offset out)
  string(SUBSTRING "${hex}" ${offset} 8 bytes)
  string(SUBSTRING "${bytes}" 0 2 a)
  string(SUBSTRING "${bytes}" 2 2 b)
  string(SUBSTRING "${bytes}" 4 2 c)
  string(SUBSTRING "${bytes}" 6 2 d)
  math(EXPR value "0x${d}${c}${b}${a}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
# Decode only package native formats. No archive extraction or external member access.
function(_v64_native hex relative member index absolute_offset out)
  set(${out} FALSE PARENT_SCOPE)
  string(LENGTH "${hex}" length)
  if(length LESS 4)
    return()
  endif()
  string(SUBSTRING "${hex}" 0 4 magic)
  set(machine "")
  set(observed "")
  set(bits 0)
  if(magic STREQUAL "4d5a")
    set(${out} TRUE PARENT_SCOPE)
    if(length LESS 128)
      _v64_fail("${relative}" "malformed_truncated_PE" "${member}")
      set(observed malformed_truncated_PE)
    else()
      _v64_u32("${hex}" 120 nt)
      math(EXPR nt "${nt}*2")
      math(EXPR required "${nt}+52")
      if(length LESS required)
        _v64_fail("${relative}" "malformed_truncated_PE" "${member}")
        set(observed malformed_truncated_PE)
      else()
        string(SUBSTRING "${hex}" ${nt} 8 signature)
        math(EXPR at "${nt}+40")
        string(SUBSTRING "${hex}" ${at} 2 low)
        math(EXPR at "${at}+2")
        string(SUBSTRING "${hex}" ${at} 2 high)
        math(EXPR optional_size "0x${high}${low}")
        math(EXPR required "${nt}+48+${optional_size}*2")
        math(EXPR at "${nt}+8")
        string(SUBSTRING "${hex}" ${at} 4 machine)
        math(EXPR at "${nt}+48")
        string(SUBSTRING "${hex}" ${at} 4 optional)
        if(length LESS required OR optional_size LESS 112)
          set(observed malformed_truncated_PE_optional_header)
        elseif(NOT signature STREQUAL "50450000")
          set(observed malformed_PE_signature)
        elseif(optional STREQUAL "0b02")
          set(bits 64)
          set(observed "PE32+")
        elseif(optional STREQUAL "0b01")
          set(bits 32)
          set(observed PE32)
        else()
          set(observed malformed_PE_optional_header)
        endif()
      endif()
    endif()
  elseif(magic MATCHES "^(6486|64aa|4c01|c401|c001)$")
    set(${out} TRUE PARENT_SCOPE)
    set(machine "${magic}")
    set(observed COFF)
    if(length LESS 40)
      set(observed malformed_truncated_COFF)
    else()
      string(SUBSTRING "${hex}" 4 2 low)
      string(SUBSTRING "${hex}" 6 2 high)
      math(EXPR required "40+0x${high}${low}*80")
      if(length LESS required)
        set(observed malformed_truncated_COFF_sections)
      elseif(machine MATCHES "^(6486|64aa)$")
        set(bits 64)
      else()
        set(bits 32)
      endif()
    endif()
  elseif(length GREATER_EQUAL 16 AND hex MATCHES "^0000ffff")
    set(${out} TRUE PARENT_SCOPE)
    string(SUBSTRING "${hex}" 12 4 machine)
    set(observed COFF_import)
    if(length LESS 40)
      set(observed malformed_truncated_COFF_import)
    else()
      string(SUBSTRING "${hex}" 8 4 version)
      if(version STREQUAL "0000")
        _v64_u32("${hex}" 24 data_size)
        math(EXPR required "40+${data_size}*2")
      else()
        # Anonymous/big COFF objects have a longer fixed header.
        set(required 112)
      endif()
      if(length LESS required)
        set(observed malformed_truncated_COFF_import_data)
      elseif(machine MATCHES "^(6486|64aa)$")
        set(bits 64)
      elseif(machine MATCHES "^(4c01|c401|c001)$")
        set(bits 32)
      endif()
    endif()
  elseif(hex MATCHES "^(7f454c46|cffaedfe|cefaedfe|feedface|feedfacf|cafebabe|bebafeca|cafebabf|bfbafeca)")
    set(${out} TRUE PARENT_SCOPE)
    set(observed unsupported_foreign_native_format)
  else()
    return()
  endif()
  if(machine STREQUAL "6486")
    set(arch x64)
  elseif(machine STREQUAL "64aa")
    set(arch arm64)
  elseif(machine STREQUAL "4c01")
    set(arch i386)
  elseif(machine MATCHES "^(c401|c001)$")
    set(arch ARM32)
  else()
    set(arch unknown)
  endif()
  string(APPEND observed "/${arch}")
  if(NOT bits EQUAL 64 OR NOT arch STREQUAL _target_arch)
    _v64_fail("${relative}" "${observed}" "${member}")
  endif()
  _v64_add(native_units 1)
  if(bits GREATER 0)
    _v64_add(native_slices 1)
  else()
    _v64_add(malformed_native_units 1)
  endif()
  _v64_escape("${relative}" path_json)
  _v64_escape("${member}" member_json)
  string(SHA256 content_hash "${hex}")
  math(EXPR size "${length}/2")
  message(STATUS "V64_NATIVE_UNIT {\"path\":\"${path_json}\",\"member\":\"${member_json}\",\"index\":${index},\"offset\":${absolute_offset},\"bytes\":${size},\"hex_sha256\":\"${content_hash}\",\"machine\":\"${arch}\",\"bits\":${bits}}")
endfunction()
function(_v64_member hex relative name index offset classification)
  _v64_escape("${relative}" path_json)
  _v64_escape("${name}" name_json)
  if(classification STREQUAL "external_unresolved")
    set(fields "\"bytes\":null,\"hex_sha256\":null")
  else()
    string(LENGTH "${hex}" length)
    math(EXPR bytes "${length}/2")
    string(SHA256 hash "${hex}")
    set(fields "\"bytes\":${bytes},\"hex_sha256\":\"${hash}\"")
  endif()
  message(STATUS "V64_NATIVE_MEMBER {\"path\":\"${path_json}\",\"name\":\"${name_json}\",\"index\":${index},\"offset\":${offset},\"classification\":\"${classification}\",${fields}}")
endfunction()
function(_v64_archive hex relative)
  _v64_add(archive_files 1)
  string(LENGTH "${hex}" length)
  set(cursor 16)
  set(names "")
  set(index 0)
  set(native_file FALSE)
  if(hex MATCHES "^213c7468696e3e0a")
    set(thin TRUE)
  else()
    set(thin FALSE)
  endif()
  while(cursor LESS length)
    math(EXPR required "${cursor}+120")
    if(length LESS required)
      _v64_fail("${relative}" malformed_truncated_archive "")
      break()
    endif()
    string(SUBSTRING "${hex}" ${cursor} 120 raw)
    string(SUBSTRING "${raw}" 116 4 trailer)
    string(SUBSTRING "${raw}" 0 32 name_hex)
    string(SUBSTRING "${raw}" 96 20 size_hex)
    _v64_ascii("${name_hex}" name)
    _v64_ascii("${size_hex}" size)
    string(STRIP "${name}" name)
    string(STRIP "${size}" size)
    if(NOT size MATCHES "^[0-9]+$" OR NOT trailer STREQUAL "600a")
      _v64_fail("${relative}" malformed_archive_header "")
      break()
    endif()
    math(EXPR cursor "${cursor}+120")
    set(metadata FALSE)
    if(name STREQUAL "/" OR name STREQUAL "//" OR name MATCHES "^__.SYMDEF")
      set(metadata TRUE)
    endif()
    if(name MATCHES "^/([0-9]+)$")
      set(start "${CMAKE_MATCH_1}")
      string(LENGTH "${names}" names_length)
      if(start GREATER_EQUAL names_length)
        _v64_fail("${relative}" malformed_archive_longname "${name}")
        break()
      endif()
      string(SUBSTRING "${names}" ${start} -1 tail)
      string(FIND "${tail}" "/\n" stop)
      if(stop LESS 0)
        _v64_fail("${relative}" malformed_archive_longname "${name}")
        break()
      endif()
      string(SUBSTRING "${tail}" 0 ${stop} name)
    endif()
    if(thin AND NOT metadata)
      _v64_add(archive_members 1)
      _v64_add(unresolved_thin_external_members 1)
      _v64_fail("${relative}" thin_archive "${name}")
      math(EXPR body_offset "${cursor}/2")
      _v64_member("" "${relative}" "${name}" ${index} ${body_offset} external_unresolved)
      break()
    endif()
    math(EXPR body_length "${size}*2")
    math(EXPR required "${cursor}+${body_length}")
    if(required GREATER length)
      _v64_fail("${relative}" malformed_truncated_archive "${name}")
      break()
    endif()
    string(SUBSTRING "${hex}" ${cursor} ${body_length} body)
    math(EXPR body_offset "${cursor}/2")
    if(name STREQUAL "//")
      _v64_ascii("${body}" names)
    elseif(name MATCHES "^#1/([0-9]+)$")
      set(name_size "${CMAKE_MATCH_1}")
      math(EXPR chars "${name_size}*2")
      if(chars GREATER body_length)
        _v64_fail("${relative}" malformed_archive_BSD_name "${name}")
        break()
      endif()
      string(SUBSTRING "${body}" 0 ${chars} name_hex)
      _v64_ascii("${name_hex}" name)
      string(SUBSTRING "${body}" ${chars} -1 body)
      math(EXPR body_offset "${body_offset}+${name_size}")
    elseif(NOT metadata)
      string(REGEX REPLACE "/$" "" name "${name}")
    endif()
    if(metadata)
      _v64_add(archive_metadata_members 1)
      set(classification metadata)
    else()
      _v64_add(archive_members 1)
      _v64_native("${body}" "${relative}" "${name}" ${index} ${body_offset} native)
      if(native)
        _v64_add(native_archive_members 1)
        set(native_file TRUE)
        set(classification native)
      else()
        _v64_add(neutral_archive_members 1)
        set(classification neutral)
      endif()
    endif()
    _v64_member("${body}" "${relative}" "${name}" ${index} ${body_offset} "${classification}")
    math(EXPR cursor "${cursor}+${size}*2+(${size}%2)*2")
    math(EXPR index "${index}+1")
  endwhile()
  if(native_file)
    _v64_add(native_files 1)
  endif()
endfunction()

if(NOT DEFINED PACKAGE_ROOT)
  if(NOT WIN32)
    message(FATAL_ERROR "Package extraction requires Windows")
  endif()
  get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
  find_program(SEVENZIP NAMES 7z REQUIRED)
  find_program(DUMPBIN NAMES dumpbin REQUIRED)
  file(GLOB _archives "${BUILD_DIR}/synergy*-portable.7z")
  file(GLOB _installers "${BUILD_DIR}/synergy*.msi")
  if(NOT _archives OR NOT _installers)
    message(FATAL_ERROR "Both portable archive and MSI are required")
  endif()
  foreach(_package IN LISTS _archives _installers)
    get_filename_component(_name "${_package}" NAME)
    set(_extract "${BUILD_DIR}/package-verification/${_name}")
    file(REMOVE_RECURSE "${_extract}")
    file(MAKE_DIRECTORY "${_extract}")
    if(_package MATCHES "\\.msi$")
      set(_kind msi)
      execute_process(COMMAND msiexec /a "${_package}" /qn /norestart
        "TARGETDIR=${_extract}" "/l*v" "${_extract}/administrative-extract.log"
        RESULT_VARIABLE _result TIMEOUT 120)
    else()
      set(_kind portable)
      execute_process(COMMAND "${SEVENZIP}" x "${_package}" "-o${_extract}" -y
        RESULT_VARIABLE _result OUTPUT_QUIET TIMEOUT 120)
    endif()
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "${_name}: extraction failed (${_result})")
    endif()
    file(GLOB_RECURSE _cores "${_extract}/synergy-core.exe")
    list(LENGTH _cores _count)
    if(NOT _count EQUAL 1)
      message(FATAL_ERROR "${_name}: expected exactly one core executable")
    endif()
    list(GET _cores 0 _core)
    get_filename_component(_root "${_core}" DIRECTORY)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGE_ROOT=${_root}"
      "-DPACKAGE_KIND=${_kind}" "-DDUMPBIN=${DUMPBIN}" "-DEXPECTED_ARCH=${_target_arch}"
      "-DEXTRACTION_ROOT=${_extract}" -DRUN_SMOKE=ON
      -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "${_name}: isolated package validation failed")
    endif()
  endforeach()
  return()
endif()

if(NOT DUMPBIN)
  find_program(DUMPBIN NAMES dumpbin REQUIRED)
endif()
get_filename_component(PACKAGE_ROOT "${PACKAGE_ROOT}" ABSOLUTE)
if(NOT EXISTS "${PACKAGE_ROOT}/synergy-core.exe")
  message(FATAL_ERROR "Missing packaged core executable")
endif()
file(GLOB _gui "${PACKAGE_ROOT}/synergy_*.exe")
list(LENGTH _gui _gui_count)
if(NOT _gui_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one versioned GUI executable")
endif()
if(PACKAGE_KIND STREQUAL "portable")
  if(EXISTS "${PACKAGE_ROOT}/synergy-daemon.exe")
    message(FATAL_ERROR "Portable archive must not contain the service daemon")
  endif()
elseif(PACKAGE_KIND STREQUAL "msi")
  if(NOT EXISTS "${PACKAGE_ROOT}/synergy-daemon.exe")
    message(FATAL_ERROR "MSI must contain the service daemon")
  endif()
else()
  message(FATAL_ERROR "PACKAGE_KIND must be msi or portable")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../deploy/windows/runtime-dependencies.cmake")
if(NOT EXTRACTION_ROOT)
  set(EXTRACTION_ROOT "${PACKAGE_ROOT}")
endif()
get_filename_component(EXTRACTION_ROOT "${EXTRACTION_ROOT}" ABSOLUTE)
file(GLOB_RECURSE _payload LIST_DIRECTORIES TRUE "${EXTRACTION_ROOT}/*")
set(_binaries "")
foreach(_binary IN LISTS _payload)
  file(RELATIVE_PATH _relative "${EXTRACTION_ROOT}" "${_binary}")
  _v64_escape("${_relative}" _relative_json)
  if(IS_SYMLINK "${_binary}")
    file(READ_SYMLINK "${_binary}" _link)
    _v64_escape("${_link}" _link_json)
    message(STATUS "V64_NATIVE_FILE {\"path\":\"${_relative_json}\",\"symlink\":\"${_link_json}\"}")
    _v64_add(symlinks_not_followed 1)
    get_filename_component(_resolved "${_binary}" REALPATH)
    file(RELATIVE_PATH _contained "${EXTRACTION_ROOT}" "${_resolved}")
    if(NOT EXISTS "${_binary}" OR _contained MATCHES "^\\.\\.(/|$)")
      _v64_fail("${_relative}" escaped_or_broken_symlink "")
    endif()
    continue()
  elseif(IS_DIRECTORY "${_binary}")
    continue()
  endif()
  file(SHA256 "${_binary}" _sha)
  file(READ "${_binary}" _hex HEX)
  message(STATUS "V64_NATIVE_FILE {\"path\":\"${_relative_json}\",\"sha256\":\"${_sha}\"}")
  if(_hex MATCHES "^(213c617263683e0a|213c7468696e3e0a)")
    _v64_archive("${_hex}" "${_relative}")
  else()
    _v64_native("${_hex}" "${_relative}" "" 0 0 _native)
    if(_native)
      _v64_add(native_files 1)
      if(_hex MATCHES "^4d5a")
        list(APPEND _binaries "${_binary}")
      endif()
    endif()
  endif()
endforeach()
set(_counts "")
foreach(_key native_files native_units native_slices malformed_native_units archive_files archive_members native_archive_members archive_metadata_members neutral_archive_members unresolved_thin_external_members symlinks_not_followed)
  get_property(_count GLOBAL PROPERTY "_v64_${_key}")
  if(NOT _count)
    set(_count 0)
  endif()
  string(APPEND _counts "\"${_key}\":${_count},")
endforeach()
message(STATUS "V64_NATIVE_COUNTS {${_counts}\"complete\":true}")
get_property(_native_error GLOBAL PROPERTY _v64_error)
if(_native_error)
  message(FATAL_ERROR "${_native_error}")
endif()
set(_required_images "${PACKAGE_ROOT}/synergy-core.exe" ${_gui})
if(PACKAGE_KIND STREQUAL "msi")
  list(APPEND _required_images "${PACKAGE_ROOT}/synergy-daemon.exe")
endif()
foreach(_required IN LISTS _required_images)
  if(NOT _required IN_LIST _binaries)
    file(RELATIVE_PATH _relative "${EXTRACTION_ROOT}" "${_required}")
    message(FATAL_ERROR "file=${_relative};observed=malformed missing PE image;expected=${_target_arch}")
  endif()
endforeach()
foreach(_binary IN LISTS _binaries)
  get_filename_component(_name "${_binary}" NAME)
  string(TOLOWER "${_name}" _name)
  if(_name MATCHES "^(msvcp.*d|vcruntime.*d|concrt.*d|ucrtbased)\\.dll$")
    message(FATAL_ERROR "Debug compiler runtime is not redistributable: ${_name}")
  endif()
  synergy_windows_imports("${_binary}" "${DUMPBIN}" _dependencies)
  foreach(_dependency IN LISTS _dependencies)
    synergy_windows_is_system("${_dependency}" _system)
    if(_system)
      continue()
    endif()
    # All application executables and ordinary DLLs share the package root.
    # A random DLL elsewhere in the tree or on PATH cannot satisfy an import.
    if(NOT EXISTS "${PACKAGE_ROOT}/${_dependency}")
      message(FATAL_ERROR "Missing app-local dependency ${_dependency} imported by ${_binary}")
    endif()
  endforeach()
endforeach()
if(EXISTS "${PACKAGE_ROOT}/Qt6Core.dll" OR EXISTS "${PACKAGE_ROOT}/Qt5Core.dll")
  if(NOT EXISTS "${PACKAGE_ROOT}/plugins/platforms/qwindows.dll")
    message(FATAL_ERROR "Shared Qt package lacks its Windows platform plugin")
  endif()
  if(NOT EXISTS "${PACKAGE_ROOT}/qt.conf")
    message(FATAL_ERROR "Shared Qt package lacks qt.conf")
  endif()
  file(READ "${PACKAGE_ROOT}/qt.conf" _qt_conf)
  if(NOT _qt_conf MATCHES "Plugins[ \t]*=[ \t]*plugins")
    message(FATAL_ERROR "qt.conf must use the package-local plugins directory")
  endif()
endif()
file(GLOB _licenses "${PACKAGE_ROOT}/licenses/vcpkg/*/copyright")
if(NOT _licenses)
  message(FATAL_ERROR "Missing packaged third-party copyright metadata")
endif()
foreach(_license IN LISTS _licenses)
  file(SIZE "${_license}" _license_size)
  if(_license_size EQUAL 0)
    message(FATAL_ERROR "Empty packaged third-party copyright metadata")
  endif()
endforeach()
if(EXISTS "${PACKAGE_ROOT}/Qt6Core.dll" OR EXISTS "${PACKAGE_ROOT}/Qt5Core.dll")
  file(GLOB_RECURSE _qt_licenses LIST_DIRECTORIES FALSE "${PACKAGE_ROOT}/licenses/qt/*")
  set(_qt_license_present FALSE)
  foreach(_license IN LISTS _qt_licenses)
    file(SIZE "${_license}" _license_size)
    if(_license_size GREATER 0)
      set(_qt_license_present TRUE)
    endif()
  endforeach()
  if(NOT _qt_license_present AND NOT EXISTS "${PACKAGE_ROOT}/licenses/vcpkg/qtbase/copyright")
    message(FATAL_ERROR "Missing packaged Qt license metadata")
  endif()
endif()
list(LENGTH _binaries _binary_count)
message(STATUS "Audited ${_binary_count} package PE files and app-local dependency closure (${_target_arch})")

if(RUN_SMOKE)
  if(NOT WIN32)
    message(FATAL_ERROR "Native Windows smoke requires a Windows host")
  endif()
  string(TOLOWER "$ENV{PROCESSOR_ARCHITEW6432}$ENV{PROCESSOR_ARCHITECTURE}" _host_arch)
  if((_target_arch STREQUAL "arm64" AND NOT _host_arch MATCHES "arm64") OR
      (_target_arch STREQUAL "x64" AND NOT _host_arch MATCHES "amd64"))
    message(STATUS "SKIP native launch: host ${_host_arch} cannot natively execute ${_target_arch}; dependency audit passed")
    return()
  endif()
  # Only extracted disposable payloads are changed. Preseed migration/schema so
  # GUI startup never reads the real user's legacy registry settings.
  set(_profile "${PACKAGE_ROOT}/verification-profile")
  file(MAKE_DIRECTORY "${_profile}/AppData/Roaming/TuPig Synergy" "${_profile}/state" "${PACKAGE_ROOT}/settings")
  file(WRITE "${_profile}/AppData/Roaming/TuPig Synergy/TuPig Synergy.extra.conf"
    "[migration]\nschemaVersion=2147483647\nnotifiedFor=2147483647\n[scope]\npreferSystem=false\n")
  file(WRITE "${PACKAGE_ROOT}/settings/TuPig Synergy.conf" "[core]\ncomputerName=synthetic-package-check\n")
  set(ENV{USERPROFILE} "${_profile}")
  set(ENV{HOME} "${_profile}")
  set(ENV{APPDATA} "${_profile}/AppData/Roaming")
  set(ENV{LOCALAPPDATA} "${_profile}/AppData/Local")
  set(ENV{XDG_STATE_HOME} "${_profile}/state")
  set(ENV{PATH} "$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
  unset(ENV{QT_PLUGIN_PATH})
  unset(ENV{QT_QPA_PLATFORM_PLUGIN_PATH})
  unset(ENV{QML_IMPORT_PATH})
  unset(ENV{QML2_IMPORT_PATH})
  unset(ENV{QT_QPA_PLATFORM})
  list(APPEND _gui "${PACKAGE_ROOT}/synergy-core.exe")
  foreach(_exe IN LISTS _gui)
    execute_process(COMMAND "${_exe}" --version WORKING_DIRECTORY "${_profile}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 20)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Isolated launch failed (${_result}): ${_exe}\n${_stdout}\n${_stderr}")
    endif()
  endforeach()
  message(STATUS "GUI Qt-load and core --version smoke passed with isolated profile and OS-only PATH; service not started")
endif()
