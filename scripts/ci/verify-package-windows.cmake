# Audit mode also supports deterministic parser fixtures on non-Windows hosts.
cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED PACKAGE_ROOT)
  if(NOT WIN32)
    message(FATAL_ERROR "Package extraction requires Windows")
  endif()
  get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE)
  find_program(SEVENZIP NAMES 7z REQUIRED)
  find_program(DUMPBIN NAMES dumpbin REQUIRED)
  file(GLOB _archives "${BUILD_DIR}/synergy*-portable.7z")
  file(GLOB _installers "${BUILD_DIR}/synergy*.msi")
  if(NOT _archives OR NOT _installers)
    message(FATAL_ERROR "Both portable archive and MSI are required")
  endif()
  foreach(_package IN LISTS _archives _installers)
    get_filename_component(_name "${_package}" NAME)
    set(_extract "${BUILD_DIR}/package-verification/${_name}")
    file(REMOVE_RECURSE "${_extract}")
    file(MAKE_DIRECTORY "${_extract}")
    if(_package MATCHES "\\.msi$")
      set(_kind msi)
      execute_process(COMMAND msiexec /a "${_package}" /qn /norestart
        "TARGETDIR=${_extract}" "/l*v" "${_extract}/administrative-extract.log"
        RESULT_VARIABLE _result TIMEOUT 120)
    else()
      set(_kind portable)
      execute_process(COMMAND "${SEVENZIP}" x "${_package}" "-o${_extract}" -y
        RESULT_VARIABLE _result OUTPUT_QUIET TIMEOUT 120)
    endif()
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "${_name}: extraction failed (${_result})")
    endif()
    file(GLOB_RECURSE _cores "${_extract}/synergy-core.exe")
    list(LENGTH _cores _count)
    if(NOT _count EQUAL 1)
      message(FATAL_ERROR "${_name}: expected exactly one core executable")
    endif()
    list(GET _cores 0 _core)
    get_filename_component(_root "${_core}" DIRECTORY)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGE_ROOT=${_root}"
      "-DPACKAGE_KIND=${_kind}" "-DDUMPBIN=${DUMPBIN}" -DRUN_SMOKE=ON
      -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "${_name}: isolated package validation failed")
    endif()
  endforeach()
  return()
endif()

if(NOT DUMPBIN)
  find_program(DUMPBIN NAMES dumpbin REQUIRED)
endif()
get_filename_component(PACKAGE_ROOT "${PACKAGE_ROOT}" ABSOLUTE)
if(NOT EXISTS "${PACKAGE_ROOT}/synergy-core.exe")
  message(FATAL_ERROR "Missing packaged core executable")
endif()
file(GLOB _gui "${PACKAGE_ROOT}/synergy_*.exe")
list(LENGTH _gui _gui_count)
if(NOT _gui_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one versioned GUI executable")
endif()
if(PACKAGE_KIND STREQUAL "portable")
  if(EXISTS "${PACKAGE_ROOT}/synergy-daemon.exe")
    message(FATAL_ERROR "Portable archive must not contain the service daemon")
  endif()
elseif(PACKAGE_KIND STREQUAL "msi")
  if(NOT EXISTS "${PACKAGE_ROOT}/synergy-daemon.exe")
    message(FATAL_ERROR "MSI must contain the service daemon")
  endif()
else()
  message(FATAL_ERROR "PACKAGE_KIND must be msi or portable")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../../deploy/windows/runtime-dependencies.cmake")
file(GLOB_RECURSE _binaries "${PACKAGE_ROOT}/*.exe" "${PACKAGE_ROOT}/*.dll")
set(_target_arch "")
foreach(_binary IN LISTS _binaries)
  get_filename_component(_name "${_binary}" NAME)
  string(TOLOWER "${_name}" _name)
  if(_name MATCHES "^(msvcp.*d|vcruntime.*d|concrt.*d|ucrtbased)\\.dll$")
    message(FATAL_ERROR "Debug compiler runtime is not redistributable: ${_name}")
  endif()
  execute_process(COMMAND "${DUMPBIN}" /HEADERS "${_binary}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _headers ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect PE headers: ${_binary}: ${_error}")
  endif()
  string(TOLOWER "${_headers}" _headers)
  if(_headers MATCHES "aa64 machine")
    set(_arch arm64)
  elseif(_headers MATCHES "8664 machine")
    set(_arch x64)
  else()
    message(FATAL_ERROR "Unsupported or missing PE architecture: ${_binary}")
  endif()
  if(_target_arch AND NOT _arch STREQUAL _target_arch)
    file(RELATIVE_PATH _relative_binary "${PACKAGE_ROOT}" "${_binary}")
    message(FATAL_ERROR
      "Mixed executable/DLL architectures in package: ${_relative_binary}; observed=${_arch}; expected=${_target_arch}")
  endif()
  set(_target_arch "${_arch}")
  synergy_windows_imports("${_binary}" "${DUMPBIN}" _dependencies)
  foreach(_dependency IN LISTS _dependencies)
    synergy_windows_is_system("${_dependency}" _system)
    if(_system)
      continue()
    endif()
    # All application executables and ordinary DLLs share the package root.
    # A random DLL elsewhere in the tree or on PATH cannot satisfy an import.
    if(NOT EXISTS "${PACKAGE_ROOT}/${_dependency}")
      message(FATAL_ERROR "Missing app-local dependency ${_dependency} imported by ${_binary}")
    endif()
  endforeach()
endforeach()
if(EXISTS "${PACKAGE_ROOT}/Qt6Core.dll" OR EXISTS "${PACKAGE_ROOT}/Qt5Core.dll")
  if(NOT EXISTS "${PACKAGE_ROOT}/plugins/platforms/qwindows.dll")
    message(FATAL_ERROR "Shared Qt package lacks its Windows platform plugin")
  endif()
  if(NOT EXISTS "${PACKAGE_ROOT}/qt.conf")
    message(FATAL_ERROR "Shared Qt package lacks qt.conf")
  endif()
  file(READ "${PACKAGE_ROOT}/qt.conf" _qt_conf)
  if(NOT _qt_conf MATCHES "Plugins[ \t]*=[ \t]*plugins")
    message(FATAL_ERROR "qt.conf must use the package-local plugins directory")
  endif()
endif()
file(GLOB _licenses "${PACKAGE_ROOT}/licenses/vcpkg/*/copyright")
if(NOT _licenses)
  message(FATAL_ERROR "Missing packaged third-party copyright metadata")
endif()
foreach(_license IN LISTS _licenses)
  file(SIZE "${_license}" _license_size)
  if(_license_size EQUAL 0)
    message(FATAL_ERROR "Empty packaged third-party copyright metadata")
  endif()
endforeach()
if(EXISTS "${PACKAGE_ROOT}/Qt6Core.dll" OR EXISTS "${PACKAGE_ROOT}/Qt5Core.dll")
  file(GLOB_RECURSE _qt_licenses LIST_DIRECTORIES FALSE "${PACKAGE_ROOT}/licenses/qt/*")
  set(_qt_license_present FALSE)
  foreach(_license IN LISTS _qt_licenses)
    file(SIZE "${_license}" _license_size)
    if(_license_size GREATER 0)
      set(_qt_license_present TRUE)
    endif()
  endforeach()
  if(NOT _qt_license_present AND NOT EXISTS "${PACKAGE_ROOT}/licenses/vcpkg/qtbase/copyright")
    message(FATAL_ERROR "Missing packaged Qt license metadata")
  endif()
endif()
list(LENGTH _binaries _binary_count)
message(STATUS "Audited ${_binary_count} package PE files and app-local dependency closure (${_target_arch})")

if(RUN_SMOKE)
  if(NOT WIN32)
    message(FATAL_ERROR "Native Windows smoke requires a Windows host")
  endif()
  string(TOLOWER "$ENV{PROCESSOR_ARCHITEW6432}$ENV{PROCESSOR_ARCHITECTURE}" _host_arch)
  if((_target_arch STREQUAL "arm64" AND NOT _host_arch MATCHES "arm64") OR
      (_target_arch STREQUAL "x64" AND NOT _host_arch MATCHES "amd64"))
    message(STATUS "SKIP native launch: host ${_host_arch} cannot natively execute ${_target_arch}; dependency audit passed")
    return()
  endif()
  # Only extracted disposable payloads are changed. Preseed migration/schema so
  # GUI startup never reads the real user's legacy registry settings.
  set(_profile "${PACKAGE_ROOT}/verification-profile")
  file(MAKE_DIRECTORY "${_profile}/AppData/Roaming/TuPig Synergy" "${_profile}/state" "${PACKAGE_ROOT}/settings")
  file(WRITE "${_profile}/AppData/Roaming/TuPig Synergy/TuPig Synergy.extra.conf"
    "[migration]\nschemaVersion=2147483647\nnotifiedFor=2147483647\n[scope]\npreferSystem=false\n")
  file(WRITE "${PACKAGE_ROOT}/settings/TuPig Synergy.conf" "[core]\ncomputerName=synthetic-package-check\n")
  set(ENV{USERPROFILE} "${_profile}")
  set(ENV{HOME} "${_profile}")
  set(ENV{APPDATA} "${_profile}/AppData/Roaming")
  set(ENV{LOCALAPPDATA} "${_profile}/AppData/Local")
  set(ENV{XDG_STATE_HOME} "${_profile}/state")
  set(ENV{PATH} "$ENV{SystemRoot}/System32;$ENV{SystemRoot}")
  unset(ENV{QT_PLUGIN_PATH})
  unset(ENV{QT_QPA_PLATFORM_PLUGIN_PATH})
  unset(ENV{QML_IMPORT_PATH})
  unset(ENV{QML2_IMPORT_PATH})
  unset(ENV{QT_QPA_PLATFORM})
  list(APPEND _gui "${PACKAGE_ROOT}/synergy-core.exe")
  foreach(_exe IN LISTS _gui)
    execute_process(COMMAND "${_exe}" --version WORKING_DIRECTORY "${_profile}"
      RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 20)
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "Isolated launch failed (${_result}): ${_exe}\n${_stdout}\n${_stderr}")
    endif()
  endforeach()
  message(STATUS "GUI Qt-load and core --version smoke passed with isolated profile and OS-only PATH; service not started")
endif()
