cmake_minimum_required(VERSION 3.21)

if(NOT EXPECTED_ARCH MATCHES "^(x64|arm64)$")
  message(FATAL_ERROR "EXPECTED_ARCH must be an explicit x64 or arm64 target")
endif()
string(LENGTH "${RUN_ID}" _run_length)
if(NOT RUN_ID MATCHES "^[a-z0-9][a-z0-9-]*$" OR _run_length GREATER 64)
  message(FATAL_ERROR "RUN_ID must be a fresh ASCII name of at most 64 characters")
endif()
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Native MSI intake requires Windows; do not execute PE/MSI fixtures on this host")
endif()
get_filename_component(_repo "${CMAKE_CURRENT_LIST_DIR}/../../../.." REALPATH)
file(REAL_PATH "${_repo}/build" _build_root)
string(FIND "${_build_root}/" "${_repo}/" _contained)
if(NOT _contained EQUAL 0)
  message(FATAL_ERROR "Fixture build output must remain inside this checkout")
endif()
set(_out "${_build_root}/msi64-intake-${EXPECTED_ARCH}-${RUN_ID}")
if(EXISTS "${_out}")
  message(FATAL_ERROR "Use a fresh RUN_ID; previous native evidence must remain unchanged: ${_out}")
endif()
find_program(_wix NAMES wix REQUIRED)
find_program(_certutil NAMES certutil REQUIRED)
find_program(_dumpbin NAMES dumpbin REQUIRED)
file(MAKE_DIRECTORY "${_out}")

function(_print_bounded _label _text _limit)
  string(LENGTH "${_text}" _bytes)
  string(SHA256 _sha "${_text}")
  if(_bytes GREATER _limit)
    string(SUBSTRING "${_text}" 0 ${_limit} _shown)
    message(STATUS "${_label} bytes=${_bytes} sha256=${_sha} shown=${_limit} truncated=1\n${_shown}")
  else()
    message(STATUS "${_label} bytes=${_bytes} sha256=${_sha} shown=${_bytes} truncated=0\n${_text}")
  endif()
endfunction()

function(_capture _name)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  message(STATUS "COMMAND_RESULT ${_name} exit=${_rc}")
  _print_bounded("COMMAND_STDOUT ${_name}" "${_stdout}" 32768)
  _print_bounded("COMMAND_STDERR ${_name}" "${_stderr}" 32768)
  file(WRITE "${_out}/${_name}.log" "${_stdout}${_stderr}")
  # WiX 5.0.2 HelpCommand.ExecuteAsync returns -1 after normal help output.
  # Reserve that exact status for these complete help command tuples only.
  set(_expected_rc "0")
  if((_name STREQUAL "wix-build-help" AND "${ARGN}" STREQUAL "${_wix};build;--help") OR
      (_name STREQUAL "wix-decompile-help" AND "${ARGN}" STREQUAL "${_wix};msi;decompile;--help"))
    set(_expected_rc "-1")
  elseif(_name STREQUAL "certutil-decodehex-help" AND "${ARGN}" STREQUAL "${_certutil};-decodehex;-?")
    # Both native targets return 1 for this complete decodehex help command.
    set(_expected_rc "1")
  elseif(_name STREQUAL "dumpbin-help" AND "${ARGN}" STREQUAL "${_dumpbin};/?")
    # Both native targets return 1100 for this complete help command.
    set(_expected_rc "1100")
  endif()
  if(NOT "${_rc}" STREQUAL "${_expected_rc}")
    message(FATAL_ERROR "Native fixture command failed (${_name}, ${_rc}); preserve ${_out}")
  endif()
  set(_last_stdout "${_stdout}" PARENT_SCOPE)
endfunction()

_capture(wix-version "${_wix}" --version)
if(NOT _last_stdout MATCHES "^5\\.0\\.2([+\r\n-]|$)")
  message(FATAL_ERROR "This intake freezes WiX 5.0.2 only; preserve the actual version log")
endif()
_capture(wix-build-help "${_wix}" build --help)
string(TOLOWER "${_last_stdout}" _build_help)
foreach(_switch IN ITEMS -arch -bindpath -intermediatefolder -out)
  string(FIND "${_build_help}" "${_switch}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "Actual WiX build help lacks supported switch: ${_switch}")
  endif()
endforeach()
_capture(wix-decompile-help "${_wix}" msi decompile --help)
string(TOLOWER "${_last_stdout}" _decompile_help)
foreach(_switch IN ITEMS -data -x -out)
  string(FIND "${_decompile_help}" "${_switch}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "Actual WiX decompile help lacks supported switch: ${_switch}")
  endif()
endforeach()
_capture(certutil-decodehex-help "${_certutil}" -decodehex -?)
string(TOLOWER "${_last_stdout}" _decodehex_help)
foreach(_token IN ITEMS "usage:" "certutil [options] -decodehex infile outfile [type]"
    "decode hexadecimal-encoded file" "crypt_string_*" "certutil -decodehex -?")
  string(FIND "${_decodehex_help}" "${_token}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "Actual certutil decodehex help lacks required content: ${_token}")
  endif()
endforeach()
_capture(dumpbin-help "${_dumpbin}" /?)
string(TOLOWER "${_last_stdout}" _dumpbin_help)
foreach(_token IN ITEMS "microsoft (r) coff/pe dumper version" "usage: dumpbin [options] [files]"
    "options:" "/headers" "/dependents")
  string(FIND "${_dumpbin_help}" "${_token}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "Actual dumpbin help lacks required content: ${_token}")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/fixture-manifest.cmake")
file(MAKE_DIRECTORY "${_out}/inputs")
foreach(_name IN LISTS MSI_FIXTURE_NAMES)
  _capture("decode-${_name}" "${_certutil}" -decodehex
    "${CMAKE_CURRENT_LIST_DIR}/${_name}.hex" "${_out}/inputs/${_name}.dat")
  file(SHA256 "${_out}/inputs/${_name}.dat" _sha)
  if(NOT _sha STREQUAL MSI_FIXTURE_SHA_${_name})
    message(FATAL_ERROR "Decoded controlled fixture differs from its immutable source: ${_name}")
  endif()
endforeach()
if(EXPECTED_ARCH STREQUAL "x64")
  set(_opposite arm64)
  set(_summary "x64;1033")
else()
  set(_opposite x64)
  set(_summary "Arm64;1033")
endif()

# Every package has an installed File, a referenced Binary action, an unused
# Binary stream, and a data-only Icon. Actions are defined but never scheduled.
set(_wxs_template [=[<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Synthetic MSI64 Intake" Manufacturer="Synthetic Fixtures"
    Version="1.0.0" UpgradeCode="A6012DE8-0125-4B91-9033-5BF393B1DC15" Scope="perUser" Language="1033" InstallerVersion="500">
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="FixtureDirectory" Name="SyntheticMSI64Intake">
        <Component Id="FixtureComponent" Guid="D2A2DBA4-BCC9-4F37-B2A7-F3B88493DB04" Bitness="always64">
          <File Id="InstalledPayload" Name="installed.dat" Source="@_installed@" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="Synthetic" Level="1"><ComponentRef Id="FixtureComponent" /></Feature>
    <Binary Id="ReferencedPayload" SourceFile="@_referenced@" />
    <Binary Id="UnreferencedPayload" SourceFile="@_unused@" />
    <Icon Id="DataOnlyIcon" SourceFile="@_icon@" />
    <Property Id="ARPPRODUCTICON" Value="DataOnlyIcon" />
    <CustomAction Id="BinaryFixtureAction" BinaryRef="ReferencedPayload" DllEntry="NeverExecute" Execute="immediate" />
    <CustomAction Id="InstalledFixtureAction" FileRef="InstalledPayload" ExeCommand="--never-execute" Execute="immediate" />
  </Package>
</Wix>
]=])

# Paired checks call the real production entry. No API marker means a broken
# check setup, including for expected bad fixtures; it can never count as reject.
function(_paired_require _text _token)
  string(FIND "${_text}" "${_token}" _found)
  if(_found LESS 0)
    message(FATAL_ERROR "Paired MSI check lacks required evidence: ${_token}")
  endif()
endfunction()

function(_paired_case _label _file_name _binary_name _unused_name _policy)
  set(_dir "${_out}/${_label}")
  set(_msi "${_dir}/fixture.msi")
  if(EXISTS "${_dir}/production-audit")
    message(FATAL_ERROR "Paired production audit output must be fresh")
  endif()
  file(SHA256 "${_msi}" _before)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DMSI_INPUT=${_msi}"
    -DMSI_AUDIT_ONLY=ON "-DMSI_AUDIT_DIR=${_dir}/production-audit"
    "-DEXPECTED_ARCH=${EXPECTED_ARCH}"
    -P "${_repo}/scripts/ci/verify-package-windows.cmake"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
  message(STATUS "PAIRED_COMMAND_RESULT ${_label} exit=${_rc}")
  _print_bounded("PAIRED_STDOUT ${_label}" "${_stdout}" 32768)
  _print_bounded("PAIRED_STDERR ${_label}" "${_stderr}" 32768)
  file(WRITE "${_dir}/paired-product.log" "${_stdout}${_stderr}")
  file(SHA256 "${_msi}" _after)
  if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Paired production verifier changed the input MSI")
  endif()
  set(_output "${_stdout}${_stderr}")
  _paired_require("${_output}" "MSI_AUDIT_API version=1")
  _paired_require("${_output}" "MSI_AUDIT_INPUT sha256=${_before} expected=${EXPECTED_ARCH}")
  _paired_require("${_output}" "MSI_AUDIT_INPUT_AFTER sha256=${_before}")
  _paired_require("${_output}" "MSI_AUDIT_COUNTS files=1 objects=4 actions=2 exports_source=4 exports_data=4")
  if(EXPECTED_ARCH STREQUAL "x64")
    set(_summary "x64;1033")
    set(_opposite arm64)
  else()
    set(_summary "Arm64;1033")
    set(_opposite x64)
  endif()
  _paired_require("${_output}" "MSI_AUDIT_SUMMARY template=${_summary}")
  _paired_require("${_output}" "MSI_AUDIT_OBJECT table=File stream=InstalledPayload export=File/InstalledPayload sha256=${MSI_FIXTURE_SHA_${_file_name}}")
  _paired_require("${_output}" "MSI_AUDIT_OBJECT table=Binary stream=ReferencedPayload export=Binary/ReferencedPayload sha256=${MSI_FIXTURE_SHA_${_binary_name}}")
  _paired_require("${_output}" "MSI_AUDIT_OBJECT table=Binary stream=UnreferencedPayload export=Binary/UnreferencedPayload sha256=${MSI_FIXTURE_SHA_${_unused_name}}")
  _paired_require("${_output}" "MSI_AUDIT_OBJECT table=Icon stream=DataOnlyIcon export=Icon/DataOnlyIcon sha256=${MSI_FIXTURE_SHA_icon}")
  _paired_require("${_output}" "MSI_AUDIT_ACTION action=BinaryFixtureAction table=Binary stream=ReferencedPayload")
  _paired_require("${_output}" "MSI_AUDIT_ACTION action=InstalledFixtureAction table=File stream=InstalledPayload")
  if(_policy STREQUAL "accept")
    if(NOT "${_rc}" STREQUAL "0")
      message(FATAL_ERROR "Matching-target synthetic MSI was not accepted")
    endif()
    _paired_require("${_output}" "MSI_AUDIT_RESULT accept")
  else()
    if(NOT "${_rc}" MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "Bad synthetic MSI requires a real nonzero verifier rejection")
    endif()
    if(_label STREQUAL "file-i386")
      set(_location "file=File/InstalledPayload table=File stream=InstalledPayload action=InstalledFixtureAction")
    elseif(_label STREQUAL "unreferenced-i386")
      set(_location "file=Binary/UnreferencedPayload table=Binary stream=UnreferencedPayload action=unreferenced")
    else()
      set(_location "file=Binary/ReferencedPayload table=Binary stream=ReferencedPayload action=BinaryFixtureAction")
    endif()
    if(_label STREQUAL "binary-wrong64")
      set(_observed "PE32+/${_opposite}")
    elseif(_label STREQUAL "binary-malformed")
      set(_observed "malformed")
    else()
      set(_observed "PE32/i386")
    endif()
    string(REGEX MATCHALL "MSI_AUDIT_REJECT [^\r\n]*" _reject_records "${_output}")
    list(LENGTH _reject_records _reject_count)
    if(NOT _reject_count EQUAL 1)
      message(FATAL_ERROR "Bad synthetic MSI requires one complete rejection record")
    endif()
    list(GET _reject_records 0 _reject_record)
    if(_label STREQUAL "binary-malformed")
      set(_observed_pattern "malformed[^ \r\n;]*")
    else()
      string(REPLACE "+" "\\+" _observed_pattern "${_observed}")
    endif()
    if(NOT _reject_record MATCHES "^MSI_AUDIT_REJECT ${_location} observed=${_observed_pattern} expected=${EXPECTED_ARCH}$")
      message(FATAL_ERROR "Bad synthetic MSI rejection record has incorrect fields")
    endif()
  endif()
  file(WRITE "${_dir}/paired-result.txt" "PAIRED_PRODUCT_CHECK\nPOLICY=${_policy}\nMSI_SHA256=${_before}\nEXPECTED_ARCH=${EXPECTED_ARCH}\n")
  message(STATUS "PAIRED_PRODUCT_CHECK ${_label} policy=${_policy} MSI_SHA256=${_before}")
endfunction()

function(_paired_mapping_cases)
  set(_control "${_out}/control")
  file(SHA256 "${_control}/fixture.msi" _before)
  file(READ "${_control}/source.wxs" _source)
  file(READ "${_control}/table-container/wix-wid.xml" _data)
  foreach(_kind IN ITEMS unknown-object missing-export duplicate-binary)
    set(_dir "${_control}/mapping-${_kind}")
    if(EXISTS "${_dir}")
      message(FATAL_ERROR "Paired metadata output must be fresh: ${_dir}")
    endif()
    file(MAKE_DIRECTORY "${_dir}")
    file(COPY "${_control}/exports-source" "${_control}/exports-data" DESTINATION "${_dir}")
    string(REPLACE "${_control}/exports-source" "${_dir}/exports-source" _mutated_source "${_source}")
    string(REPLACE "${_control}/exports-data" "${_dir}/exports-data" _mutated_data "${_data}")
    if(_kind STREQUAL "unknown-object")
      file(WRITE "${_dir}/exports-data/Binary/UnknownPayload" "controlled unmapped object")
    elseif(_kind STREQUAL "missing-export")
      file(REMOVE "${_dir}/exports-data/Binary/UnreferencedPayload")
    else()
      string(REGEX MATCH "<row[^>]*><field>ReferencedPayload</field><field>[^<]*</field></row>" _row "${_mutated_data}")
      if(_row STREQUAL "")
        message(FATAL_ERROR "Native Binary row shape differs; do not infer duplicate metadata")
      endif()
      string(REPLACE "<table name=\"Binary\">" "<table name=\"Binary\">${_row}" _mutated_data "${_mutated_data}")
    endif()
    file(WRITE "${_dir}/source.wxs" "${_mutated_source}")
    file(WRITE "${_dir}/tables.xml" "${_mutated_data}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_XML=${_dir}/source.wxs"
      "-DDATA_XML=${_dir}/tables.xml" "-DSOURCE_EXPORTS=${_dir}/exports-source"
      "-DDATA_EXPORTS=${_dir}/exports-data" "-DEXPECTED_ARCH=${EXPECTED_ARCH}"
      -P "${CMAKE_CURRENT_LIST_DIR}/mapping-driver.cmake"
      RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
    message(STATUS "PAIRED_MAPPING_RESULT ${_kind} exit=${_rc}")
    _print_bounded("PAIRED_MAPPING_STDOUT ${_kind}" "${_stdout}" 32768)
    _print_bounded("PAIRED_MAPPING_STDERR ${_kind}" "${_stderr}" 32768)
    file(WRITE "${_dir}/paired-mapping.log" "${_stdout}${_stderr}")
    set(_output "${_stdout}${_stderr}")
    _paired_require("${_output}" "MSI_AUDIT_API version=1")
    _paired_require("${_output}" "MSI_AUDIT_MAPPING_REJECT kind=${_kind}")
    if(NOT "${_rc}" MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "Controlled bad metadata requires a real verifier rejection")
    endif()
    message(STATUS "PAIRED_MAPPING_CHECK ${_kind} rejected")
  endforeach()
  file(SHA256 "${_control}/fixture.msi" _after)
  if(NOT _before STREQUAL _after)
    message(FATAL_ERROR "Paired metadata checks changed the input MSI")
  endif()
endfunction()

function(_case _label _file_name _binary_name _unused_name _policy)
  set(_dir "${_out}/${_label}")
  file(MAKE_DIRECTORY "${_dir}")
  # Relative controlled names avoid embedding an unescaped workspace path in XML.
  set(_installed "${_file_name}.dat")
  set(_referenced "${_binary_name}.dat")
  set(_unused "${_unused_name}.dat")
  set(_icon "icon.dat")
  string(CONFIGURE "${_wxs_template}" _wxs @ONLY)
  file(WRITE "${_dir}/fixture.wxs" "${_wxs}")
  # In WiX 5.0.2 the direct CLI build does not invoke ICE. Validation is a
  # separate msi validate subcommand/SDK target. Do not pass legacy -sval.
  _capture("${_label}-build" "${_wix}" build "${_dir}/fixture.wxs"
    -arch "${EXPECTED_ARCH}" -b "${_out}/inputs"
    -intermediatefolder "${_dir}/intermediate" -o "${_dir}/fixture.msi")
  set(_msi "${_dir}/fixture.msi")
  file(SHA256 "${_msi}" _before)
  message(STATUS "MSI_INPUT ${_label} sha256=${_before}")
  # Capture both representations and their input-hash controls before checking
  # assumed export shape, so an actual schema mismatch retains raw table data.
  foreach(_mode IN ITEMS source data)
    set(_exports "${_dir}/exports-${_mode}")
    if(_mode STREQUAL "source")
      _capture("${_label}-source" "${_wix}" msi decompile "${_msi}" -x "${_exports}" -o "${_dir}/source.wxs")
    else()
      _capture("${_label}-data" "${_wix}" msi decompile "${_msi}" -data -x "${_exports}" -o "${_dir}/tables.wixout")
    endif()
    file(SHA256 "${_msi}" _after)
    message(STATUS "MSI_INPUT_AFTER ${_label} ${_mode} sha256=${_after}")
    file(GLOB_RECURSE _diagnostic_files LIST_DIRECTORIES FALSE "${_exports}/*")
    list(LENGTH _diagnostic_files _diagnostic_count)
    message(STATUS "EXPORT_COUNT ${_label} ${_mode} count=${_diagnostic_count}")
    foreach(_file IN LISTS _diagnostic_files)
      file(RELATIVE_PATH _relative "${_exports}" "${_file}")
      if(IS_SYMLINK "${_file}" OR _relative MATCHES "^\\.\\.")
        message(STATUS "EXPORT_OBSERVED ${_label} ${_mode} ${_relative} sha256=NOT_READ_UNSAFE_PATH")
      else()
        file(SHA256 "${_file}" _sha)
        message(STATUS "EXPORT_OBSERVED ${_label} ${_mode} ${_relative} sha256=${_sha}")
      endif()
    endforeach()
    if(NOT _before STREQUAL _after)
      message(FATAL_ERROR "Read-only decompile changed the input MSI")
    endif()
    if(_mode STREQUAL "data")
      file(ARCHIVE_EXTRACT INPUT "${_dir}/tables.wixout" DESTINATION "${_dir}/table-container")
      set(_xml_path "${_dir}/table-container/wix-wid.xml")
      if(NOT EXISTS "${_xml_path}")
        message(FATAL_ERROR "WiX 5.0.2 native data schema differs; freeze this actual output before product parsing")
      endif()
      file(SIZE "${_xml_path}" _xml_size)
      file(SHA256 "${_xml_path}" _xml_sha)
      file(READ "${_xml_path}" _xml LIMIT 262144)
      message(STATUS "NATIVE_TABLE_INFO ${_label} bytes=${_xml_size} sha256=${_xml_sha}")
      _print_bounded("NATIVE_TABLES ${_label}" "${_xml}" 262144)
      if(_xml_size GREATER 262144)
        message(FATAL_ERROR "Unexpected native fixture table size")
      endif()
      foreach(_table IN ITEMS File Binary Icon CustomAction _SummaryInformation)
        if(NOT _xml MATCHES "<table name=\"${_table}\"")
          message(FATAL_ERROR "Native table missing (${_table}); do not infer mapping from source authoring")
        endif()
      endforeach()
      foreach(_token IN ITEMS InstalledPayload ReferencedPayload UnreferencedPayload DataOnlyIcon BinaryFixtureAction InstalledFixtureAction "${_summary}")
        string(FIND "${_xml}" "${_token}" _found)
        if(_found LESS 0)
          message(FATAL_ERROR "Native fixture mapping/summary token missing: ${_token}")
        endif()
      endforeach()
    endif()
  endforeach()
  foreach(_mode IN ITEMS source data)
    set(_exports "${_dir}/exports-${_mode}")
    file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE "${_exports}/*")
    list(LENGTH _files _count)
    if(NOT _count EQUAL 4)
      message(FATAL_ERROR "Expected four exact native File/Object exports, observed ${_count}; freeze native schema before changing this check")
    endif()
    set(_expected_names "${_file_name};${_binary_name};${_unused_name};icon")
    set(_observed_names "")
    foreach(_file IN LISTS _files)
      file(RELATIVE_PATH _relative "${_exports}" "${_file}")
      if(IS_SYMLINK "${_file}" OR _relative MATCHES "^\\.\\.")
        message(FATAL_ERROR "Fixture export escaped its disposable payload")
      endif()
      file(SHA256 "${_file}" _sha)
      set(_matched "")
      foreach(_name IN LISTS _expected_names)
        if(_sha STREQUAL MSI_FIXTURE_SHA_${_name})
          set(_matched "${_name}")
        endif()
      endforeach()
      if(NOT _matched)
        message(FATAL_ERROR "Unexplained File/Object export: ${_relative}")
      endif()
      list(APPEND _observed_names "${_matched}")
      file(READ "${_file}" _prefix LIMIT 2 HEX)
      if(_prefix STREQUAL "4d5a")
        execute_process(COMMAND "${_dumpbin}" /headers "${_file}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _headers ERROR_VARIABLE _errors)
        message(STATUS "COMMAND_RESULT ${_label}-${_mode}-${_matched}-headers exit=${_rc}")
        _print_bounded("COMMAND_STDOUT ${_label}-${_mode}-${_matched}-headers" "${_headers}" 32768)
        _print_bounded("COMMAND_STDERR ${_label}-${_mode}-${_matched}-headers" "${_errors}" 32768)
        file(WRITE "${_dir}/${_mode}-${_matched}-headers.log" "${_headers}${_errors}")
        if(NOT _rc EQUAL 0 AND NOT _matched STREQUAL "truncated")
          message(FATAL_ERROR "Independent native dumpbin rejected a controlled full PE fixture")
        endif()
      endif()
      file(APPEND "${_dir}/inventory.tsv" "${_mode}\t${_relative}\t${_sha}\t${_matched}\n")
      message(STATUS "EXPORT ${_label} ${_mode} ${_relative} ${_sha} ${_matched}")
    endforeach()
    list(SORT _observed_names)
    list(SORT _expected_names)
    if(NOT _observed_names STREQUAL _expected_names)
      message(FATAL_ERROR "Native exports did not preserve each declared File/Object payload")
    endif()
  endforeach()
  file(WRITE "${_dir}/result.txt" "ROUNDTRIP_ONLY\nMSI_SHA256=${_before}\nEXPECTED_ARCH=${EXPECTED_ARCH}\nEXPECTED_POLICY=${_policy}\nPRODUCT_MSI_VERIFIER=NOT_RUN\n")
  message(STATUS "ROUNDTRIP_ONLY ${_label} MSI_SHA256=${_before} EXPECTED_POLICY=${_policy} PRODUCT_MSI_VERIFIER=NOT_RUN")
  if(MSI_PAIRED_CHECKS)
    _paired_case("${_label}" "${_file_name}" "${_binary_name}" "${_unused_name}" "${_policy}")
  endif()
endfunction()

_case(control "${EXPECTED_ARCH}-exe" "${EXPECTED_ARCH}-dll" text accept)
_case(binary-i386 "${EXPECTED_ARCH}-exe" x86-dll text reject)
_case(binary-wrong64 "${EXPECTED_ARCH}-exe" "${_opposite}-dll" text reject)
_case(unreferenced-i386 "${EXPECTED_ARCH}-exe" "${EXPECTED_ARCH}-dll" x86-dll reject)
_case(file-i386 x86-exe "${EXPECTED_ARCH}-dll" text reject)
_case(binary-malformed "${EXPECTED_ARCH}-exe" truncated text reject)
if(MSI_PAIRED_CHECKS)
  _paired_mapping_cases()
endif()
message(STATUS "Native intake complete; full MSI verifier accept/reject and both-target package acceptance remain pending")
